# Skopiuj te zmienne 1:1 do Hostinger → Node.js → Environment variables.
# Hasła wklej ręcznie — tego pliku nie commituj z prawdziwymi sekretami.

APP_URL=https://tatraoffroad.pl
NEXT_PUBLIC_APP_URL=https://tatraoffroad.pl

PAYLOAD_SECRET=zmien-na-dlugi-losowy-ciag

# Supabase → Connect → Session pooler (port 5432), NIE Transaction (6543)
# i NIE sam db.xxx.supabase.co (to jest tylko IPv6).
DATABASE_URL=postgresql://postgres.PROJEKT:HASLO@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=no-verify
DATABASE_SSL=true
PAYLOAD_PUSH=true

CASHBILL_SHOP_ID=tatraoffroad.pl
CASHBILL_SECRET=wstaw-sekret-cashbill

# Opcjonalnie (albo w Payload → Ustawienia rezerwacji)
# GCAL_CALENDAR_ID=
# GCAL_SERVICE_ACCOUNT_JSON=
